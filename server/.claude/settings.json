{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python .claude/skills/building-skills/scripts/validate_skill.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./src/_config/**/*.local.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./src/_config/**/*.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-claude-skills.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
